# Copy to .env for local configuration. Never commit real secrets.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DATABASE_URL=sqlite:///./marcapasos.db
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional PostgreSQL deployment example; use a secret manager for credentials.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/galix
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30

# Optional OpenAI-compatible tutor provider. Noah uses local responses if unset.
# NOAH_LLM_BASE_URL=https://api.openai.com/v1
# NOAH_LLM_API_KEY=provide-through-a-secret-manager
# NOAH_LLM_MODEL=your-approved-model
NOAH_MAX_CONCURRENT_REQUESTS=8